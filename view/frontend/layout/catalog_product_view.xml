<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.form.content">
            <block class="Magento\Framework\View\Element\Template" name="zero.giftcard.product" before="product.info.addtocart"
                   template="Zero_GiftCard::product.phtml">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\GiftCard\ViewModel\Product</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
