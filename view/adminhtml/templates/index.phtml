            <form method="post" action="<?= $escaper->escapeUrl($save) ?>">
                <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
                <input type="hidden" name="id" value="<?= (int) $card['card_id'] ?>">
                <input type="hidden" name="do" value="send">
                <button type="submit" class="action-secondary"><?= $escaper->escapeHtml(__('Email It Again')) ?></button>
            </form>
        <?php endif; ?>
        <form method="post" action="<?= $escaper->escapeUrl($save) ?>" style="display: flex; gap: 8px; align-items: center;">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
            <input type="hidden" name="id" value="<?= (int) $card['card_id'] ?>">
            <input type="hidden" name="do" value="adjust">
            <input class="admin__control-text" type="number" step="0.01" name="amount" required style="width: 110px;"
