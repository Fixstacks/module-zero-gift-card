    <table class="admin__table-secondary" style="max-width: 640px; margin-bottom: 20px;">
        <tr><th><?= $escaper->escapeHtml(__('Balance')) ?></th><td data-giftcard-balance><?= $escaper->escapeHtml($admin->money($card, (float) $card['balance'])) ?> / <?= $escaper->escapeHtml($admin->money($card, (float) $card['initial_amount'])) ?></td></tr>
        <tr><th><?= $escaper->escapeHtml(__('Status')) ?></th><td><?= $escaper->escapeHtml((int) $card['is_active'] ? __('Active') : __('Off')) ?></td></tr>
