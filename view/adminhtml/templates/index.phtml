                    <td><?= $escaper->escapeHtml($admin->money($card, (float) $row['balance'])) ?></td>
                    <td><?= $escaper->escapeHtml((string) $row['order_increment_id']) ?></td>
                    <td><?= $escaper->escapeHtml((string) $row['comment']) ?></td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
<?php else: ?>
    <section class="admin__fieldset-wrapper" style="margin-bottom: 30px;">
        <h2 class="admin__legend"><?= $escaper->escapeHtml(__('Make a Gift Card')) ?></h2>
        <form method="post" action="<?= $escaper->escapeUrl($save) ?>" class="zero-giftcard-make"
              style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
            <label><?= $escaper->escapeHtml(__('Amount (base currency)')) ?><br>
                <input class="admin__control-text" type="number" step="0.01" min="0.01" name="amount" id="giftcard-amount" required style="width: 130px;">
            </label>
            <label><?= $escaper->escapeHtml(__('Store View')) ?><br>
                <select class="admin__control-select" name="store_id">
                    <?php foreach ($admin->storeViews() as $id => $name): ?>
                        <option value="<?= (int) $id ?>"><?= $escaper->escapeHtml($name) ?></option>
                    <?php endforeach; ?>
                </select>
            </label>
            <label><?= $escaper->escapeHtml(__('To (name)')) ?><br>
                <input class="admin__control-text" type="text" name="recipient_name" maxlength="100">
            </label>
            <label><?= $escaper->escapeHtml(__('Recipient Email')) ?><br>
                <input class="admin__control-text" type="email" name="recipient_email" id="giftcard-email">
            </label>
            <label><?= $escaper->escapeHtml(__('From (name)')) ?><br>
                <input class="admin__control-text" type="text" name="sender_name" maxlength="100">
            </label>
            <label><?= $escaper->escapeHtml(__('Message')) ?><br>
                <input class="admin__control-text" type="text" name="message" maxlength="500" style="width: 300px;">
            </label>
            <label style="align-self: center;"><input type="checkbox" name="send" value="1" checked> <?= $escaper->escapeHtml(__('Email it')) ?></label>
            <button type="submit" class="action-primary"><?= $escaper->escapeHtml(__('Make Gift Card')) ?></button>
        </form>
    </section>
    <form method="get" action="<?= $escaper->escapeUrl($admin->url('zero_giftcard/card/index')) ?>" style="margin-bottom: 15px; display: flex; gap: 8px;">
        <input class="admin__control-text" type="search" name="q" value="<?= $escaper->escapeHtmlAttr($admin->search()) ?>"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Code, recipient or order')) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Search gift cards')) ?>" style="width: 300px;">
        <button type="submit" class="action-secondary"><?= $escaper->escapeHtml(__('Search')) ?></button>
    </form>
    <table class="data-grid zero-giftcard-list">
        <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Code')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Balance')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('To')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Order')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Made (UTC)')) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($admin->all() as $row): ?>
                <tr>
                    <td style="font-family: monospace;"><a href="<?= $escaper->escapeUrl($admin->url('zero_giftcard/card/index', ['id' => $row['card_id']])) ?>"><?= $escaper->escapeHtml($row['code']) ?></a></td>
                    <td><?= $escaper->escapeHtml($admin->money($row, (float) $row['balance'])) ?> / <?= $escaper->escapeHtml($admin->money($row, (float) $row['initial_amount'])) ?></td>
                    <td><?= $escaper->escapeHtml((int) $row['is_active'] ? __('Active') : __('Off')) ?></td>
                    <td><?= $escaper->escapeHtml(trim($row['recipient_name'] . ' ' . $row['recipient_email'])) ?></td>
                    <td><?= $escaper->escapeHtml((string) $row['order_increment_id']) ?></td>
                    <td><?= $escaper->escapeHtml($row['created_at']) ?></td>
                </tr>
            <?php endforeach; ?>
            <?php if (!$admin->all()): ?>
                <tr><td colspan="6"><?= $escaper->escapeHtml(__('No gift cards yet.')) ?></td></tr>
            <?php endif; ?>
        </tbody>
    </table>
<?php endif; ?>
