<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <!-- Gift cards pay like money: after the grand total, which they lower. -->
    <section name="quote">
        <group name="totals">
            <item name="zero_giftcard" instance="Zero\GiftCard\Model\Total\Quote\GiftCard" sort_order="600"/>
        </group>
    </section>
    <section name="order_invoice">
        <group name="totals">
            <item name="zero_giftcard" instance="Zero\GiftCard\Model\Total\Invoice\GiftCard" sort_order="400"/>
        </group>
    </section>
    <section name="order_creditmemo">
        <group name="totals">
            <item name="zero_giftcard" instance="Zero\GiftCard\Model\Total\Creditmemo\GiftCard" sort_order="450"/>
        </group>
    </section>
</config>
